    {
      "topLeftX": 112,
      "topLeftY": 274,
      "bottomRightX": 254,
      "bottomRightY": 289,
      "content": "### 7.2.2 Link Commands",
      "confidenceScores": null,
      "type": "title"
    },
    {
      "topLeftX": 111,
      "topLeftY": 297,
      "bottomRightX": 637,
      "bottomRightY": 372,
      "content": "Link commands are used for link level data integrity, flow control and link power management. Link commands are a fixed length of eight symbols and contain repeated symbols to increase the error tolerance. Refer to Section 7.3 for more details. Link command names have the L-preface to differentiate their link level usage and to avoid confusion with packets.",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 112,
      "topLeftY": 385,
      "bottomRightX": 306,
      "bottomRightY": 399,
      "content": "#### 7.2.2.1 Link Command Structure",
      "confidenceScores": null,
      "type": "title"
    },
    {
      "topLeftX": 111,
      "topLeftY": 408,
      "bottomRightX": 668,
      "bottomRightY": 437,
      "content": "Link command shall be eight symbols long and constructed with the following format shown in",
